#!/bin/sh
cd "${0%/*}" || exit                                # Run from this directory
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # Tutorial run functions
#------------------------------------------------------------------------------

# Parallel round trip ascii -> coherent -> ascii with foamCoherentConvert
# (build with applications/Allwmake)

restore0Dir
cp controlDict.orig system/controlDict

# Create and decompose mesh, run in ascii format
foamDictionary -entry writeFormat -set ascii system/controlDict
runApplication blockMesh
runApplication decomposePar
runParallel $(getApplication)

# Convert mesh and fields (all times) to coherent format.
# The partitioning is retained.
runParallel -s toCoherent foamCoherentConvert coherent

# Continue the run in coherent format
foamDictionary -entry writeFormat -set coherent system/controlDict
foamDictionary -entry startFrom -set latestTime system/controlDict
foamDictionary -entry endTime -set 1 system/controlDict
runParallel -s coherent $(getApplication)

# Convert back to ascii format into the processor directories
runParallel -s toLegacy foamCoherentConvert ascii

# Continue the run in ascii format
foamDictionary -entry writeFormat -set ascii system/controlDict
foamDictionary -entry endTime -set 1.5 system/controlDict
runParallel -s ascii $(getApplication)

#------------------------------------------------------------------------------
