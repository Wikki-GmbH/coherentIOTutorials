#!/bin/sh
cd "${0%/*}" || exit                                # Run from this directory
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # Tutorial run functions
#------------------------------------------------------------------------------

restore0Dir
cp controlDict.orig system/controlDict

# Create and decompose mesh in ascii format
foamDictionary -entry writeFormat -set ascii system/controlDict
runApplication -s 'ascii' blockMesh
runApplication decomposePar

# Run using ascii format
runParallel $(getApplication)

## Use renumberMesh as a converter in two steps: first for the mesh, then for
# the fields.

# Utility renumberMesh reads the mesh in legacy format from constant/polyMesh
# since 'ascii' is specified as write format in controlDict.  Flag
# "-write-coherent" enforces writing the mesh in coherent format.  Flag
# "-overwrite" enforces writing to constant/polyMesh.
runParallel -s 'convert-mesh' renumberMesh -no-fields -renumber-method none \
    -write-coherent -overwrite

# Now set writeFormat to coherent for field conversion.  The mesh will be read
# in coherent format from constant/polyMesh.  The fields will be read in legacy
# format and written in coherent format.
foamDictionary -entry writeFormat -set coherent system/controlDict
runParallel -s 'convert-fields' renumberMesh -latestTime -renumber-method none

echo '\nFirst 3 elements of U in legacy format:'
grep -r "internalField" processor0/0.5/U -A 5

echo '\nFirst 3 elements of U in coherent format:'
bpls -d 0.505/data.bp/ U/internalField -c "3,3,1" -n 3

#------------------------------------------------------------------------------
