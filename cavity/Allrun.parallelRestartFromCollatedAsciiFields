#!/bin/sh
cd "${0%/*}" || exit                                # Run from this directory
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # Tutorial run functions
#------------------------------------------------------------------------------

restore0Dir
cp controlDict.orig system/controlDict

# Create a mesh in ascii format
foamDictionary -entry writeFormat -set ascii system/controlDict
runApplication -s 'ascii' blockMesh
runApplication decomposePar -fileHandler collated

# Run using ascii format
runParallel $(getApplication) -fileHandler collated

## Use renumberMesh as a converter in two steps: first for the mesh, then for
# the fields.

# Utility renumberMesh reads the mesh in legacy format from constant/polyMesh
# since 'ascii' is specified as write format in controlDict.
# Flag "-write-coherent" enforces writing the mesh in coherent format.
# Flag "-overwrite" enforces writing to constant/polyMesh.
runParallel -s 'convert-mesh' renumberMesh -no-fields -renumber-method none \
    -write-coherent -overwrite -fileHandler collated

# Now set writeFormat to coherent to enforce reading the coherent mesh.  The
# fields will be read in legacy format and written in coherent format.
foamDictionary -entry writeFormat -set coherent system/controlDict
foamDictionary -entry startFrom -set latestTime system/controlDict
foamDictionary -entry endTime -set 1 system/controlDict
runParallel -s 'coherent' $(getApplication)

echo '\nFirst 3 elements of U in legacy format from processor 0 and time 0.5:'
grep "processor0" processors9/0.5/U -A 18

echo '\nFirst 3 elements of U in coherent format from time 1:'
bpls -d 1/data.bp/ U/internalField -c "3,3,1" -n 3

#------------------------------------------------------------------------------
